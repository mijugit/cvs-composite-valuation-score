{
    "name": "cvs/app",
    "description": "Composite Valuation Score — stock analysis and ranking tool",
    "type": "project",
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "CVS\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CVS\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testdox"
    },
    "config": {
        "optimize-autoloader": true
    }
}
