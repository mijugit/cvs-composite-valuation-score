# Copy this file to .env and fill in your values.
# .env is listed in .gitignore and must NEVER be committed.

APP_ENV=development
APP_URL=http://localhost

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cvs_db
DB_USER=root
DB_PASS=

# --- Claude API (CVS\Ai client, phase 2) ---
# Optional until the AI layer is used. Key and model ID NEVER committed / hardcoded.
# NOTE: the .env parser keeps everything after '=' — do NOT put inline comments
# after a value (e.g. `AI_MODEL=claude-sonnet-4-6   # note` would break the value).
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-4-6
# AI_MAX_TOKENS=2048
# AI_TIMEOUT=20
# AI_MAX_RETRIES=2
# AI_TOTAL_TIMEOUT=25
# AI_RETRY_BASE_DELAY_MS=500
# AI_ANTHROPIC_VERSION=2023-06-01
# AI_BASE_URL=https://api.anthropic.com/v1/messages
