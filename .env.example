# Copy this file to .env and fill in your values.
# .env is listed in .gitignore and must NEVER be committed.

APP_ENV=development
APP_URL=http://localhost

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cvs_db
DB_USER=root
DB_PASS=

# --- Claude API (CVS\Ai client, phase 2) ---
# Optional until the AI layer is used. Key and model ID NEVER committed / hardcoded.
# ANTHROPIC_API_KEY=
# AI_MODEL=                       # current Sonnet or Haiku model ID (set at deploy)
# AI_MAX_TOKENS=2048
# AI_TIMEOUT=20                   # per-attempt seconds; retries stay within ~25s total
# AI_MAX_RETRIES=2
# AI_ANTHROPIC_VERSION=2023-06-01
# AI_BASE_URL=https://api.anthropic.com/v1/messages
