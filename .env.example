# Copy this file to .env and fill in your values.
# .env is listed in .gitignore and must NEVER be committed.

APP_ENV=development
APP_URL=http://localhost
APP_SECRET=change-me-to-a-random-64-char-hex-string

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cvs_db
DB_USER=root
DB_PASS=

# --- Claude API (CVS\Ai client, phase 2) ---
# Optional until the AI layer is used. Key and model ID NEVER committed / hardcoded.
# NOTE: the .env parser keeps everything after '=' — do NOT put inline comments
# after a value (e.g. `AI_MODEL=claude-sonnet-4-6   # note` would break the value).
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-4-6
# AI_MAX_TOKENS=2048
# AI_TIMEOUT=20
# AI_MAX_RETRIES=2
# AI_TOTAL_TIMEOUT=25
# AI_RETRY_BASE_DELAY_MS=500
# AI_ANTHROPIC_VERSION=2023-06-01
# AI_BASE_URL=https://api.anthropic.com/v1/messages

# --- Gemini API (CVS\Ai\GeminiClient, change: llm-gemini-wallet) ---
# Optional until the LLM Gemini wallet is used. Key and model ID NEVER committed /
# hardcoded. NOTE: variable name is `Gemini_CVS` (not GEMINI_API_KEY) — it already
# exists on the server under that exact name/casing; $_ENV keys are case-sensitive.
# Same inline-comment caveat as the AI_* section above applies here too.
# Gemini_CVS=
# GEMINI_MODEL=gemini-3.7-flash
# GEMINI_MAX_TOKENS=8192
# GEMINI_TIMEOUT=180
# GEMINI_MAX_RETRIES=2
# GEMINI_TOTAL_TIMEOUT=200
# GEMINI_RETRY_BASE_DELAY_MS=500
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Stage-2 "Recenzja krytyczna" background worker (change: cvs-ai-critical-review) ---
# bin/generate_critical_review.php runs detached (exec '&') — not bound by the
# synchronous request's timeout above. A real web-search-enabled call was measured
# at 138.8s live; defaults below give it headroom. Retries off (one retry doubles
# the worst-case wait).
# AI_CRITICAL_REVIEW_TIMEOUT=180
# AI_CRITICAL_REVIEW_TOTAL_TIMEOUT=190
# AI_CRITICAL_REVIEW_MAX_RETRIES=0
