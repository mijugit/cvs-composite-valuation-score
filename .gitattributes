# Normalize line endings: LF in repo, OS-native on checkout
* text=auto

# PHP/web files — always LF (Linux server target: Cyber_Folks)
*.php text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.htaccess text eol=lf
.env.example text eol=lf
.gitignore text eol=lf

# Binary files — no line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.phar binary
